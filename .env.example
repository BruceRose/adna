# Copy to .env.local and fill in.

# Postgres connection string. Leave empty to use the built-in embedded
# database stored in ./data/pglite (fine for local development and demos).
# e.g. postgres://user:pass@host:5432/audience_dna?sslmode=require
DATABASE_URL=

# Password for the /admin area.
ADMIN_PASSWORD=change-me

# Random string, at least 32 characters, used to sign admin sessions.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Secret for the daily retention job (/api/cron/retention). Vercel Cron sends
# it automatically as "Authorization: Bearer <CRON_SECRET>".
# Generate one with: openssl rand -base64 32
CRON_SECRET=
